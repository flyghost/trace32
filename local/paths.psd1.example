# 把本文件复制成 local\paths.psd1，并填入你本机的路径。
# local\ 下的一切都被 git 忽略，所以你的机器布局永远不会进
# 仓库：仓库里的脚本只带这些占位符
#   __T32_INSTALL__, __BSP_DIR__, __TMP_DIR__, __T32_START_TEMP__
# 由 run_smoke.ps1 在运行时替换。
@{
    # TRACE32 安装目录：包含 bin\windows64\ 的那个文件夹
    T32_INSTALL = 'C:\T32'

    # RT-Thread BSP 构建输出目录，其中含
    # rtthread.bin（不带连字符）和 rt-thread.elf（带连字符！）
    BSP_DIR = 'C:\rt-thread\bsp\stm32\stm32f407-atk-explorer'
}
