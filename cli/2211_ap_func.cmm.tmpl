; =============================================================================
;  2211 AP 死亡现场 - 无界面单函数入口  （模板）
;
;  由 cli\run_2211_func.ps1 展开成 local\func_<name>.cmm。
;  要改请改本文件和 cmm\functions.json，绝不要改生成出来的副本。
;
;  一个函数，两个入口：
;    GUI 入口       third_party\vendor\2210_trace32\LM620_Restore.cmm  (按钮 + DIALOG.* + STOP)
;    无界面入口     本脚本，由 cli\run_2211_func.ps1 驱动
;  两者调用的是 third_party\vendor\2210_trace32 下同一批客户脚本，这些脚本从不
;  被修改。区别只在参数从哪来：GUI 里来自对话框，这里来自命令行。
;  GUI 外壳被绕开，是因为 DIALOG.* 在 SCREEN=OFF 下会永久卡死；
;  select_thread.cmm 同样被绕开（它的链表遍历改由 cmm\thread_pick.cmm 带着
;  命令行传入的线程名重做）。
;
;  每个函数的主体放在 cmm\functions.json 里，所以注册表是唯一的真相来源：
;  没有任何函数被实现两遍。
;
;  脚本路径：对厂商脚本的调用用绝对的 __SCRIPT_DIR__ 路径，同时运行器把 TRACE32
;  的工作目录设为 third_party\vendor\2210_trace32 - 两者缺一不可，因为客户的
;  脚本之间用裸名字互相调用（restore.cmm 里写 `do frame.cmm`），只有当前目录是
;  该目录时才能解析到。
;
;  报告是一个打印 AREA -> __OUT_FILE__（16 KB 缓冲，由 AREA.Close 刷出）；
;  进度标记走 __MARKER_LOG__ 这个独立通道。
; =============================================================================
ON ERROR CONTinue

LOCAL &ramdump &elf &out &want &info &start &end &sp &size &thread_struct &found

&ramdump="__RAMDUMP_DIR__"
&elf="&ramdump"+"\__ELF_NAME__"
&out="__OUT_FILE__"
&want="__PARAM_THREAD__"

APPEND __MARKER_LOG__ "F00START"

AREA.Create FuncData 120. 20000.
AREA.CLEAR FuncData
AREA.Open FuncData "&out"

PRINT "##################################################################"
PRINT "#  headless single function: __FUNC_NAME__"
PRINT "#  GUI twin: __FUNC_BUTTON__"
PRINT "#  __FUNC_DESC__"
PRINT "##################################################################"

; ---- 前置步骤：GUI 的 LOAD 按钮所建立的状态 --------------------------------
do __SCRIPT_DIR__\restore.cmm "&ramdump" "&elf"
APPEND __MARKER_LOG__ "F01RESTORE"

PRINT "@@@[__FUNC_NAME__]"
__FUNC_BODY__
PRINT ""

PRINT "##################################################################"
PRINT "#  END OF FUNCTION __FUNC_NAME__"
PRINT "##################################################################"

AREA.Close FuncData
APPEND __MARKER_LOG__ "F99END"
ON ERROR
QUIT
