; =============================================================================
;  2211 AP 死亡现场  -  无界面分析入口（无 GUI，无 DIALOG.*）
;
;  本文件是模板。cli\run_2211_ap.ps1 会把它展开成 local\run_2211_ap.cmm。
;  要改就改模板，绝不要改生成出来的副本。
;
;  它原样驱动 third_party\vendor\2210_trace32\ 下客户的原版脚本。
;  有意绕开的部分：
;     LM620_Restore.cmm  - GUI 外壳（27 处 DIALOG.* + STOP）；在 SCREEN=OFF 下会卡死
;     select_thread.cmm  - 交互式线程选择器（4 处 DIALOG.* + STOP）
;  third_party\vendor\2210_trace32 下其余脚本都不含 DIALOG，均在此被调用。
;
;  脚本路径：每次调用都用绝对的 __SCRIPT_DIR__ 路径，同时运行器把 TRACE32 的
;  工作目录设为 third_party\vendor\2210_trace32。两者缺一不可：裸写的
;  `do restore.cmm` 是按进程当前目录解析的，而客户的脚本之间又用裸名字互相调用
;  （例如 restore.cmm 里写 `do frame.cmm`），只有当前目录就是它们自己所在目录时
;  才能解析到。
;
;  ARENA 那一节是我们写的，不是客户的：show_ap_meminfo.cmm 和
;  show_ap_meminfo_sum.cmm 都会调用一个既没有环检测、也没有 size==0 保护的
;  dlmalloc 遍历器，两者在本 arena 上都会死循环
;  （实测：先跑的顺序里是第 8 节，后来是第 9 节，都只能跑几分钟后杀掉，
;  且零输出）。它们的遍历还依赖 dlmalloc 内部 typedef（mbinptr / mchunkptr）
;  和 sizeof()，而这些在本环境里根本无法求值。
;  改由 cmm\heap_summary.cmm 使用真正可靠可读的 arena 描述符；
;  块链由 tools\heap_stats_offline.py 离线重算。
;
;  运行必须完整跑完：打印 AREA 只在其 16 KB 缓冲写满、或 AREA.Close 执行时
;  才落盘。实测：杀掉 TRACE32 会丢掉上一个 16 KB 边界之后打印的全部内容 -
;  在 2211 上，被杀掉的那次运行保住了第 1-6 节，
;  却静默丢掉了第 7、8 节，尽管它们的 marker 已经写出了。
;  所以 heap 一节放在最后，
;  也所以要有 marker 这样一条独立于打印的进度通道。
;
;  两个互相独立的输出通道，这是刻意的：
;     1) 打印 AREA   -> __OUT_FILE__   （给人看的报告）
;     2) APPEND 标记 -> __MARKER_LOG__ （进度凭证，以防某个错误在报告写全之前
;        就中断了打印流水线）
;  ramdump 只被读取；不会往 ramdump 目录里写任何东西。
; =============================================================================
ON ERROR CONTinue

LOCAL &ramdump &elf &out

&ramdump="__RAMDUMP_DIR__"
&elf="&ramdump"+"\cpu-ap.elf"
&out="__OUT_FILE__"

APPEND __MARKER_LOG__ "H00START"

AREA.Create PrintData 120. 20000.
AREA.CLEAR PrintData
AREA.Open PrintData "&out"

PRINT "##################################################################"
PRINT "#  2211 AP death scene - headless extraction"
PRINT "#  run     : __RUN_STAMP__"
PRINT "#  ramdump : &ramdump"
PRINT "#  elf     : &elf"
PRINT "#  engine  : third_party\vendor\2210_trace32 (customer originals, unmodified)"
PRINT "##################################################################"
PRINT ""

PRINT "@@@[1/9] restore.cmm - load IRAM/PSRAM/ilm/dlm/xip + elf, set exception frame"
do __SCRIPT_DIR__\restore.cmm "&ramdump" "&elf"
IF sYmbol.EXIST(g_osAssert)
(
    APPEND __MARKER_LOG__ "H01A-g_osAssert-OK"
)
ELSE
(
    APPEND __MARKER_LOG__ "H01A-g_osAssert-MISSING"
)
&b0=Data.Long(D:0x10200000)
&b1=Data.Long(D:0x40000000)
APPEND __MARKER_LOG__ "H01B-MEM "+FORMAT.HEX(8.,&b0)+" "+FORMAT.HEX(8.,&b1)
APPEND __MARKER_LOG__ "H01RESTORE"
PRINT ""

PRINT "@@@[2/9] show_sysinfo.cmm - current thread and IRQ nesting"
IF sYmbol.EXIST(g_osCurrentThread)
(
    do __SCRIPT_DIR__\show_sysinfo.cmm
    ENTRY &info
    PRINT "SYSINFO: &info"
)
ELSE
(
    PRINT "SYSINFO: <no symbol g_osCurrentThread>"
)
APPEND __MARKER_LOG__ "H02SYSINFO"
PRINT ""

PRINT "@@@[3/9] errinfo.cmm - assert / RISC-V exception decode"
do __SCRIPT_DIR__\errinfo.cmm
ENTRY &info
PRINT "ERRINFO: &info"
APPEND __MARKER_LOG__ "H03ERRINFO"
PRINT ""

PRINT "@@@[4/9] show_thread.cmm - thread list"
do __SCRIPT_DIR__\show_thread.cmm
APPEND __MARKER_LOG__ "H04THREAD"
PRINT ""

PRINT "@@@[5/9] backtrace.cmm + frame.cmm - exception trace (exc_trace)"
&start=Var.Value(exc_trace)
&end=&start+0x1000
do __SCRIPT_DIR__\backtrace.cmm &start &end
do __SCRIPT_DIR__\frame.cmm &start
APPEND __MARKER_LOG__ "H05TRACE"
PRINT ""

PRINT "@@@[6/9] show_all_backtrace.cmm - backtrace of every thread"
do __SCRIPT_DIR__\show_all_backtrace.cmm
APPEND __MARKER_LOG__ "H06ALLBT"
PRINT ""

PRINT "@@@[7/9] show_mailbox.cmm - mailbox state"
do __SCRIPT_DIR__\show_mailbox.cmm
APPEND __MARKER_LOG__ "H07MAILBOX"
PRINT ""

PRINT "@@@[8/9] show_thread_swap.cmm - thread swap table"
do __SCRIPT_DIR__\show_thread_swap.cmm
APPEND __MARKER_LOG__ "H08SWAP"
PRINT ""

; ---- dlmalloc arena 描述符，刻意放在最后 -----------------------------------
; 厂商的 print_dlmalloc_heap.cmm / print_mem_summary_by_file.cmm 既没有环检测，
; 也没有 size==0 保护，两者在本 arena 上都会死循环
; （实测：跑几分钟零输出后被杀掉）。它们的遍历还需要
; dlmalloc 内部 typedef（mbinptr / mchunkptr）和 sizeof()，而这些表达式在本环境中
; 完全无法求值（实测：用到它们的每一行都静默地什么也不输出）。
; 因此 cmm\heap_summary.cmm 只报告真正可靠可读的内容，
; 并在输出里写明这一限制。
PRINT "@@@[9/9] dlmalloc arena summary - AP system mem (cmm\heap_summary.cmm)"
IF sYmbol.EXIST(g_osApSystemMem)
(
    do __CMM_DIR__\heap_summary.cmm &g_osApSystemMem
)
ELSE
(
    PRINT "HEAPSUMMARY-AP skipped: symbol g_osApSystemMem does not exist"
)
APPEND __MARKER_LOG__ "H09HEAP"
PRINT ""

PRINT "##################################################################"
PRINT "#  END OF HEADLESS ANALYSIS"
PRINT "##################################################################"

AREA.Close PrintData
APPEND __MARKER_LOG__ "H99END"
ON ERROR
QUIT
